# Copiar como api/.env para cambiar la configuración (opcional en desarrollo).
PORT=4000
JWT_SECRET=una-clave-larga-y-secreta
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_DAYS=30
# true: la respuesta del envío de MFA incluye el mensaje simulado (mail/SMS) para mostrarlo en la app.
MFA_SIMULATION=true
# Fuente de datos: mysql (base de XAMPP, la misma que usa Laravel) o memoria (datos de prueba, sin MySQL).
DATA_SOURCE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=convenios_unlpam
DB_USERNAME=root
DB_PASSWORD=