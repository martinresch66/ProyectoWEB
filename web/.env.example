# Copiar como .env.local (cp .env.example .env.local) y reiniciar `npm run dev` después de cambiarlo.

# URL base de la API de Laravel (sin barra al final).
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# true  = la web usa un servidor simulado en el navegador con los datos de database/seeds.sql
#         (sirve para trabajar mientras el backend no está listo).
# false = la web le habla al backend real en NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_USE_MOCK=true
