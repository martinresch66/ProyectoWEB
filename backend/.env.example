#Un .env.example es una plantilla pública que sí se sube a Git. 
#No tiene contraseñas ni datos sensibles, solo lista los nombres de las variables que la app necesita para arrancar. 
#Cuando alguien clona el repositorio, simplemente hace una copia de ese .env.example, lo renombra a .env y le pone sus
#propios datos locales.

APP_NAME="Convenios UNLPam"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Argentina/Buenos_Aires
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=convenios_unlpam
DB_USERNAME=root
DB_PASSWORD=

JWT_SECRET=