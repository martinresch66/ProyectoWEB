#Un .env.example es una plantilla pública que sí se sube a Git. 
#No tiene contraseñas ni datos sensibles, solo lista los nombres de las variables que la app necesita para arrancar. 
#Cuando alguien clona el repositorio, simplemente hace una copia de ese .env.example, lo renombra a .env y le pone sus
#propios datos locales.

# Plantilla pública de variables de entorno (subir a Git sin contraseñas ni claves reales).
# Copiar como .env y completar los valores locales antes de ejecutar la aplicación.

APP_NAME="Convenios UNLPam"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Argentina/Buenos_Aires
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# URL del frontend Next.js para configuración de CORS y Sanctum
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

# Base de datos MySQL
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=convenios_unlpam
DB_USERNAME=root
DB_PASSWORD=

# Drivers de sesión, caché y colas
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Almacenamiento de archivos adjuntos (PDFs / documentos de convenios)
FILESYSTEM_DISK=local